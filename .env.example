# Copy this file to .env and replace every PassWord42! value.

# API
API_PORT=8080
JWT_SECRET=PassWord42!-use-at-least-64-random-characters
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# PostgreSQL
POSTGRES_USER=vigil
POSTGRES_PASSWORD=PassWord42!
POSTGRES_DB=lopo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_IMAGE=postgres:17-alpine

# ClickHouse
CLICKHOUSE_USER=vigil
CLICKHOUSE_PASSWORD=PassWord42!
CLICKHOUSE_DB=default

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.6.5-distroless
CLICKHOUSE_CLIENT_IMAGE=clickhouse/clickhouse-server:26.8.6.5
CLICKHOUSE_WRITER_PASSWORD=PassWord42!

# OpenTelemetry Collector
VIGIL_INGESTION_KEY=PassWord42!-replace-with-a-long-random-ingestion-key
BACKEND_CALLBACK_URL=http://api:8081/internal/alerts/trigger-evaluation
OTLP_HTTP_PORT=4318
MAX_SERIALIZED_BATCH_BYTES=1048576
DEDUP_BUCKET_WIDTH=1s
COLLECTOR_MEMORY_LIMIT_MIB=384
COLLECTOR_MEMORY_SPIKE_LIMIT_MIB=96

VIGIL_DOMAIN=localhost
