{
	admin localhost:2019
	default_sni localhost
}

(vigil-routes) {
	route {
		@sensitive path_regexp sensitive `(?i)(^|/)(\.env([./]|$)|\.(git|svn|hg)(/|$)|\.(htaccess|htpasswd|DS_Store)(/|$))`
		respond @sensitive 403

		@internal path /internal /internal/*
		handle @internal {
			respond 404
		}

		handle /api/* {
			reverse_proxy waf:8080 {
				# Caddy is the public trust boundary; never accept a client-chosen IP.
				header_up X-Forwarded-For {remote_host}
				header_up -Forwarded
			}
		}

		handle_path /otlp/* {
			reverse_proxy telemetry-collector:4318
		}

		handle {
			root * /usr/share/caddy
			try_files {path} /index.html
			file_server
		}
	}
}

localhost {
	tls internal
	import vigil-routes
}
