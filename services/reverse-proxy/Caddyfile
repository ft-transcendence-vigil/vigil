{
	admin 0.0.0.0:2019
	default_sni localhost
}

(vigil-routes) {
	route {
		@sensitive {
			path /.env /.env.* */.env */.env.* /.git /.git/* */.git/*
		}
		respond @sensitive 403

		handle /internal/* {
			respond 404
		}

		handle /api/* {
			reverse_proxy waf:8080
		}

		handle_path /otlp/* {
			reverse_proxy telemetry-collector:4318
		}

		handle {
			root * /usr/share/caddy
			try_files {path} /index.html
			file_server
		}
	}
}

localhost {
	tls internal
	import vigil-routes
}
