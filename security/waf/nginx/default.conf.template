# Caddy terminates TLS; this container is an internal HTTP WAF.
server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }
    # Match decoded paths, including nested files, before API proxying.
    location ~* (^|/)(\.env([./]|$)|\.(git|svn|hg)(/|$)|\.(htaccess|htpasswd|DS_Store)(/|$)) {
        return 403;
    }
    # JWT is supplied in ?token=; never put it in Nginx access logs.
    location = /api/alerts/ws {
        access_log off;
        client_max_body_size 13m;
        include includes/proxy_backend.conf;
    }
    # Buffering is disabled for every API response, including telemetry GET SSE
    # and POST /api/alerts/{id}/ask; no endpoint-specific bypass of ModSecurity.
    location /api/ {
        client_max_body_size 13m;
        include includes/proxy_backend.conf;
    }
    location / { return 404; }
    include includes/location_common.conf;
}
